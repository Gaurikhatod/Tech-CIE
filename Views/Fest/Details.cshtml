@model Participant

@{
ViewData["Title"] = "Participant Details";

var status =
    Model.GetRegistrationStatus();

var category =
    Model.GetFeeCategory();


}

<div class="row justify-content-center">

```
<div class="col-xl-9">

    <div class="details-card">

        <div class="details-header">

            <div class="d-flex
                        justify-content-between
                        align-items-start
                        flex-wrap
                        gap-3">

                <div>

                    <div class="section-label text-white-50">
                        REGISTRATION PROFILE
                    </div>

                    <h1 class="fw-bold mt-2 mb-2">
                        @Model.ParticipantName
                    </h1>

                    <p class="mb-0 text-white-50">
                        Participant #@Model.ParticipantId
                    </p>

                </div>

                @if (status == "Confirmed")
                {
                    <span class="badge bg-success fs-6 px-3 py-2">
                        ✓ Confirmed
                    </span>
                }
                else
                {
                    <span class="badge bg-warning text-dark fs-6 px-3 py-2">
                        Pending
                    </span>
                }

            </div>

        </div>


        <div class="p-4 p-md-5">

            @if (status == "Confirmed")
            {
                <div class="alert alert-success mb-4">

                    <h5 class="fw-bold">
                        Registration Confirmed
                    </h5>

                    <p class="mb-0">

                        Welcome,
                        <strong>
                            @Model.ParticipantName
                        </strong>!

                        You are registered for

                        <strong>
                            @Model.EventName
                        </strong>.

                    </p>

                </div>
            }
            else
            {
                <div class="alert alert-warning mb-4">

                    <h5 class="fw-bold">
                        Registration Pending
                    </h5>

                    <p class="mb-0">
                        Your registration is currently pending.
                    </p>

                </div>
            }


            <div class="row g-3">

                <div class="col-md-6">

                    <div class="detail-item">

                        <div class="detail-label">
                            Participant Name
                        </div>

                        <div class="detail-value">
                            @Model.ParticipantName
                        </div>

                    </div>

                </div>


                <div class="col-md-6">

                    <div class="detail-item">

                        <div class="detail-label">
                            Email Address
                        </div>

                        <div class="detail-value">
                            @Model.Email
                        </div>

                    </div>

                </div>


                <div class="col-md-6">

                    <div class="detail-item">

                        <div class="detail-label">
                            Department
                        </div>

                        <div class="detail-value">
                            @Model.Department
                        </div>

                    </div>

                </div>


                <div class="col-md-6">

                    <div class="detail-item">

                        <div class="detail-label">
                            Academic Year
                        </div>

                        <div class="detail-value">
                            @Model.Year
                        </div>

                    </div>

                </div>


                <div class="col-md-6">

                    <div class="detail-item">

                        <div class="detail-label">
                            Registered Event
                        </div>

                        <div class="detail-value">
                            @Model.EventName
                        </div>

                    </div>

                </div>


                <div class="col-md-6">

                    <div class="detail-item">

                        <div class="detail-label">
                            Team Participation
                        </div>

                        <div class="detail-value">

                            @if (Model.IsTeamEvent)
                            {
                                <span class="text-success">
                                    ✓ Team Event
                                </span>
                            }
                            else
                            {
                                <span>
                                    Individual Event
                                </span>
                            }

                        </div>

                    </div>

                </div>


                <div class="col-md-6">

                    <div class="detail-item">

                        <div class="detail-label">
                            Registration Fee
                        </div>

                        <div class="detail-value fs-4">
                            ₹@(Model.RegistrationFee ?? 0)
                        </div>

                    </div>

                </div>


                <div class="col-md-6">

                    <div class="detail-item">

                        <div class="detail-label">
                            Fee Category
                        </div>

                        <div class="detail-value">

                            @if (category == "Premium Event")
                            {
                                <span class="badge bg-dark">
                                    Premium Event
                                </span>
                            }
                            else if (category == "Standard Event")
                            {
                                <span class="badge bg-primary">
                                    Standard Event
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-success">
                                    Free Event
                                </span>
                            }

                        </div>

                    </div>

                </div>

            </div>


            <div class="mt-5 pt-4 border-top">

                <a asp-controller="Fest"
                   asp-action="Index"
                   class="btn btn-outline-secondary">

                    ← Back to Participants

                </a>

                <a asp-controller="Fest"
                   asp-action="Register"
                   class="btn btn-primary">

                    Register Another →

                </a>

            </div>

        </div>

    </div>

</div>
```

</div>
