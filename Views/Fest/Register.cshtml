@model Participant

@{
ViewData["Title"] = "Register";

var events =
    ViewBag.Events as List<Event>
    ?? new List<Event>();


}

<div class="form-container">

```
<div class="text-center mb-4">

    <div class="section-label">
        JOIN THE FEST
    </div>

    <h1 class="fw-bold mt-2">
        Event Registration
    </h1>

    <p class="text-muted">
        Complete your details and choose your challenge.
    </p>

</div>


<div class="form-card">

    <div class="form-header">

        <div class="d-flex
                    justify-content-between
                    align-items-center">

            <div>

                <h3 class="fw-bold mb-1">
                    Participant Information
                </h3>

                <p class="mb-0 text-white-50">
                    All fields marked as required must be completed.
                </p>

            </div>

            <div class="fs-1">
                ✦
            </div>

        </div>

    </div>


    <div class="form-body">

        <form asp-controller="Fest"
              asp-action="Register"
              method="post">

            <div asp-validation-summary="ModelOnly"
                 class="alert alert-danger">
            </div>


            <!-- NAME -->

            <div class="mb-4">

                <label asp-for="ParticipantName"
                       class="form-label">
                </label>

                <input asp-for="ParticipantName"
                       class="form-control"
                       placeholder="Enter your full name" />

                <span asp-validation-for="ParticipantName"
                      class="text-danger small">
                </span>

            </div>


            <!-- EMAIL -->

            <div class="mb-4">

                <label asp-for="Email"
                       class="form-label">
                </label>

                <input asp-for="Email"
                       class="form-control"
                       placeholder="student@example.com" />

                <span asp-validation-for="Email"
                      class="text-danger small">
                </span>

            </div>


            <div class="row">

                <!-- DEPARTMENT -->

                <div class="col-md-6 mb-4">

                    <label asp-for="Department"
                           class="form-label">
                    </label>

                    <select asp-for="Department"
                            class="form-select">

                        <option value="">
                            Select Department
                        </option>

                        <option>CSE</option>
                        <option>IT</option>
                        <option>AI & ML</option>
                        <option>ECE</option>
                        <option>Mechanical</option>
                        <option>Civil</option>

                    </select>

                    <span asp-validation-for="Department"
                          class="text-danger small">
                    </span>

                </div>


                <!-- YEAR -->

                <div class="col-md-6 mb-4">

                    <label asp-for="Year"
                           class="form-label">
                    </label>

                    <select asp-for="Year"
                            class="form-select">

                        <option value="">
                            Select Year
                        </option>

                        <option>1st Year</option>
                        <option>2nd Year</option>
                        <option>3rd Year</option>
                        <option>4th Year</option>

                    </select>

                    <span asp-validation-for="Year"
                          class="text-danger small">
                    </span>

                </div>

            </div>


            <!-- EVENT -->

            <div class="mb-4">

                <label asp-for="EventName"
                       class="form-label">
                </label>

                <select asp-for="EventName"
                        class="form-select">

                    <option value="">
                        Select your event
                    </option>

                    @foreach (var festEvent in events)
                    {
                        <option value="@festEvent.EventName">

                            @festEvent.EventName
                            — ₹@festEvent.RegistrationFee

                        </option>
                    }

                </select>

                <span asp-validation-for="EventName"
                      class="text-danger small">
                </span>

            </div>


            <!-- TEAM EVENT -->

            <div class="modern-card p-3 mb-4">

                <div class="form-check">

                    <input asp-for="IsTeamEvent"
                           class="form-check-input" />

                    <label asp-for="IsTeamEvent"
                           class="form-check-label fw-semibold">
                    </label>

                </div>

                <small class="text-muted ms-4">
                    Select this if you are participating
                    as part of a team.
                </small>

            </div>


            <!-- BUTTONS -->

            <div class="d-flex
                        justify-content-between
                        align-items-center
                        flex-wrap
                        gap-2">

                <a asp-controller="Fest"
                   asp-action="Index"
                   class="btn btn-outline-secondary">

                    ← Cancel

                </a>

                <button type="submit"
                        class="btn btn-primary btn-lg">

                    Complete Registration →

                </button>

            </div>

        </form>

    </div>

</div>
```

</div>

@section Scripts {

```
<partial name="_ValidationScriptsPartial" />
```

}
