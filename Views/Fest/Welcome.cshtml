@{
ViewData["Title"] = "AMTICS Technical Fest";
}

<div class="hero-section animate-up">

```
<div class="hero-content">

    <div class="hero-badge">
        <span>✦</span>
        AMTICS COLLEGE • TECHNICAL FEST
    </div>

    <h1 class="hero-title">
        Build.
        <br />
        <span>Innovate.</span>
        <br />
        Compete.
    </h1>

    <p class="hero-description">
        Welcome to the AMTICS Technical Fest —
        a platform where students transform ideas into
        innovation, compete in challenging events and
        showcase their technical talent.
    </p>

    <div class="hero-buttons">

        <a asp-controller="Fest"
           asp-action="Register"
           class="btn btn-primary btn-lg me-2">

            Register for an Event →
        </a>

        <a asp-controller="Fest"
           asp-action="Index"
           class="btn btn-outline-light btn-lg">

            Explore Participants
        </a>

    </div>

</div>
```

</div>

<!-- EVENT SECTION -->

<div class="mt-5 pt-4">

```
<div class="text-center mb-5">

    <div class="section-label">
        COMPETE & CREATE
    </div>

    <h2 class="section-title mt-2">
        Featured Technical Events
    </h2>

    <p class="text-muted">
        Choose your challenge and demonstrate your skills.
    </p>

</div>


<div class="row g-4">

    <div class="col-md-6 col-lg-3">

        <div class="event-card h-100 animate-up">

            <div class="event-icon mb-4">
                💻
            </div>

            <h5 class="fw-bold">
                Code Sprint
            </h5>

            <p class="text-muted small">
                Solve challenging programming problems
                under time constraints.
            </p>

            <div class="mt-4 fw-bold">
                FREE
            </div>

        </div>

    </div>


    <div class="col-md-6 col-lg-3">

        <div class="event-card h-100 animate-up delay-1">

            <div class="event-icon mb-4">
                🤖
            </div>

            <h5 class="fw-bold">
                AI Innovation
            </h5>

            <p class="text-muted small">
                Build innovative solutions using
                artificial intelligence.
            </p>

            <div class="mt-4 fw-bold">
                ₹300
            </div>

        </div>

    </div>


    <div class="col-md-6 col-lg-3">

        <div class="event-card h-100 animate-up delay-2">

            <div class="event-icon mb-4">
                🚀
            </div>

            <h5 class="fw-bold">
                Hackathon
            </h5>

            <p class="text-muted small">
                Transform your idea into a working
                technology solution.
            </p>

            <div class="mt-4 fw-bold">
                ₹750
            </div>

        </div>

    </div>


    <div class="col-md-6 col-lg-3">

        <div class="event-card h-100 animate-up delay-3">

            <div class="event-icon mb-4">
                🛡️
            </div>

            <h5 class="fw-bold">
                Cyber Security
            </h5>

            <p class="text-muted small">
                Test your security knowledge through
                technical challenges.
            </p>

            <div class="mt-4 fw-bold">
                ₹500
            </div>

        </div>

    </div>

</div>
```

</div>

<!-- CTA -->

<div class="glass-card mt-5 p-5 text-center">

```
<div class="section-label">
    READY?
</div>

<h2 class="fw-bold mt-2">
    Your next technical challenge starts here.
</h2>

<p class="text-muted">
    Register today and become part of the AMTICS
    Technical Fest.
</p>

<a asp-controller="Fest"
   asp-action="Register"
   class="btn btn-primary mt-3">

    Start Registration →
</a>
```

</div>
