<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>
        @ViewData["Title"] - AMTICS Technical Fest
    </title>

    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
        rel="stylesheet" />

    <link
        rel="stylesheet"
        href="~/css/site.css"
        asp-append-version="true" />

</head>

<body class="bg-light">

    <nav class="navbar navbar-expand-lg navbar-dark bg-dark shadow">

        <div class="container">

            <a class="navbar-brand fw-bold"
               asp-controller="Fest"
               asp-action="Welcome">

                AMTICS TECH FEST

            </a>

            <button class="navbar-toggler"
                    type="button"
                    data-bs-toggle="collapse"
                    data-bs-target="#navbarNav">

                <span class="navbar-toggler-icon"></span>

            </button>

            <div class="collapse navbar-collapse"
                 id="navbarNav">

                <ul class="navbar-nav ms-auto">

                    <li class="nav-item">

                        <a class="nav-link"
                           asp-controller="Fest"
                           asp-action="Welcome">

                            Home

                        </a>

                    </li>

                    <li class="nav-item">

                        <a class="nav-link"
                           asp-controller="Fest"
                           asp-action="Index">

                            Participants

                        </a>

                    </li>

                    <li class="nav-item">

                        <a class="nav-link"
                           asp-controller="Fest"
                           asp-action="Register">

                            Register

                        </a>

                    </li>

                </ul>

            </div>

        </div>

    </nav>

    <main class="container py-5">

        @RenderBody()

    </main>

    <footer class="border-top bg-white py-4">

        <div class="container text-center text-muted">

            © @DateTime.Now.Year
            AMTICS Technical Fest

        </div>

    </footer>

    <script
        src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js">
    </script>

    @await RenderSectionAsync(
        "Scripts",
        required: false)

</body>

</html>